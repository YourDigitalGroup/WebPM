# Single-page app: serve index.html for any path the file system doesn't have.
# Without this, /cf and /cf/8f3a-... return 404 instead of loading the portal.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# No directory browsing
Options -Indexes

# Long cache for fingerprinted assets, none for the shell
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
